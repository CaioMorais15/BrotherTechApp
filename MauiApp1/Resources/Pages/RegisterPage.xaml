<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YourNamespace.LoginPage"
             Title="Login">
    <ContentPage.Content>
        <StackLayout Padding="30" VerticalOptions="Center">
            <Label Text="Bem-vindo" FontSize="28" HorizontalOptions="Center" />
            <Entry Placeholder="E-mail" Keyboard="Email" Margin="0,10,0,0"/>
            <Entry Placeholder="Senha" IsPassword="True" Margin="0,10,0,0"/>
            <Button Text="Entrar" Margin="0,20,0,0" Clicked="OnLoginClicked" />
            <Button Text="Cadastrar" Margin="0,10,0,0" Clicked="OnRegisterClicked" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
